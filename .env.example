# Storage paths
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Qdrant Vector Database
# Set QDRANT_URL and QDRANT_API_KEY for Qdrant Cloud (https://cloud.qdrant.io)
# If empty, connects to local Docker container at http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# Reference date for time-dependent policies, upcoming changes, and holiday calendars
# Format: YYYY-MM-DD (e.g. 2026-10-20). If empty, defaults to system current date
APP_TODAY=2026-10-20

# LLM Provider configuration
LLM_PROVIDER=gemini

# Provider API keys
# COMPULSORY: Gemini API key (required for document embeddings and default LLM reasoning)
GEMINI_API_KEY=

# OPTIONAL: Groq API key (optional for alternative LLM responses when LLM_PROVIDER=groq)
GROQ_API_KEY=
